# syntax=docker/dockerfile:1.7
#
# Scout — api container.
#
# Multi-stage build:
#   stage 1 (spa-builder) builds the React SPA from apps/web/
#   stage 2 (py-builder)  resolves Python deps via uv
#   stage 3 (runtime)     ships venv + api source + built SPA, non-root
#
# Both Docker (`docker buildx build`) and Podman (`podman build`) consume this file.

# ============================================================================
# Stage 1: spa-builder
# ----------------------------------------------------------------------------
# Builds the Vite + React SPA. Output lands at /build/web/dist; stage 3
# copies it to /app/static in the runtime image.
#
# pnpm-lock.yaml will exist after the first `pnpm install` in dev. Until
# then we run without --frozen-lockfile (which would fail). Switch to
# --frozen-lockfile once the lockfile is committed.
# ============================================================================
FROM registry.access.redhat.com/ubi9/nodejs-22 AS spa-builder

USER 0

# Install pnpm. UBI nodejs-22 doesn't expose corepack on PATH (despite Node
# bundling it), so we install pnpm globally via npm. Version matches the
# packageManager field in apps/web/package.json so dev and container builds
# stay aligned.
RUN npm install -g pnpm@9.12.0 && npm cache clean --force

WORKDIR /build/web

# Copy manifests first for better layer caching on dep-only changes.
COPY apps/web/package.json ./
# COPY apps/web/pnpm-lock.yaml ./   # uncomment once lockfile is committed
RUN pnpm install

# Copy source.
COPY apps/web/ ./

# Build. Outputs apps/web/dist/ which stage 3 copies to /app/static.
RUN pnpm build

# ============================================================================
# Stage 2: py-builder
# ----------------------------------------------------------------------------
# Installs Python deps into a venv using uv.
# Once uv.lock is committed (step 06 generates it on first run), the sync
# command below switches to `uv sync --frozen` for reproducibility.
# ============================================================================
FROM registry.access.redhat.com/ubi9/python-312 AS py-builder

USER 0

# Pin uv version. Update via dependabot.
RUN pip install --no-cache-dir uv==0.5.4

# Use /app as the workdir in BOTH py-builder and runtime stages so the venv's
# hardcoded Python shebangs (#!/app/.venv/bin/python) resolve correctly when
# the venv is copied across. Avoids "bad interpreter" errors at exec time.
WORKDIR /app

# Copy only the manifest for better layer caching on dep-only changes.
COPY apps/api/pyproject.toml ./
# Generate venv at /app/.venv. Plan 06 commits uv.lock; switch to
# `uv sync --frozen` then.
RUN uv sync --no-dev

# Copy api source AND Alembic migration suite.
COPY apps/api/app ./app
COPY apps/api/alembic ./alembic
COPY apps/api/alembic.ini ./alembic.ini

# Plan-23 seed catalog (conference series). The migration looks for it
# at /app/db/seeds/conference_series.yaml; copy it in here so `make migrate`
# can populate the seed rows without needing the host filesystem.
COPY db/seeds ./db/seeds

# ============================================================================
# Stage 3: runtime
# ----------------------------------------------------------------------------
# Minimal runtime. Non-root user (uid 1002). Listens on :8000.
# ============================================================================
FROM registry.access.redhat.com/ubi9/python-312 AS runtime

USER 0

# System libs Docling/OpenCV pull in transitively. Without these, importing
# docling raises "libGL.so.1: cannot open shared object file" on PDF parse.
RUN dnf install -y --setopt=install_weak_deps=False \
        mesa-libGL \
        mesa-libGLU \
        libglvnd-glx \
 && dnf clean all \
 && rm -rf /var/cache/dnf

# Create the runtime user. UBI python-312's default user occupies uid 1001;
# we use 1002 to avoid the collision. Rootless Podman maps subuid to it.
RUN useradd --uid 1002 --create-home --shell /bin/bash scout \
 && mkdir -p /app /var/lib/scout/storage/pdf_uploads /var/lib/scout/storage/raw_pages \
 && chown -R scout:scout /app /var/lib/scout

WORKDIR /app

# Copy venv from py-builder. Source path matches py-builder's WORKDIR so the
# venv's hardcoded shebangs (#!/app/.venv/bin/python) resolve correctly here.
COPY --from=py-builder --chown=scout:scout /app/.venv /app/.venv

# Copy api source.
COPY --from=py-builder --chown=scout:scout /app/app /app/app

# Copy Alembic migration tree + ini. The Makefile's `make migrate` target
# runs `alembic upgrade head` from /app, where these files live.
COPY --from=py-builder --chown=scout:scout /app/alembic /app/alembic
COPY --from=py-builder --chown=scout:scout /app/alembic.ini /app/alembic.ini

# Seed catalog (plan 23) forwarded into the runtime stage.
COPY --from=py-builder --chown=scout:scout /app/db /app/db

# Copy built SPA from spa-builder.
COPY --from=spa-builder --chown=scout:scout /build/web/dist /app/static

# Make the venv the default Python. Cache dirs are pinned under scout's home
# so Docling / HuggingFace / etc. can write their model caches without
# tripping on the read-only /opt/app-root/src/.cache that ships in UBI.
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    XDG_CACHE_HOME=/home/scout/.cache \
    HF_HOME=/home/scout/.cache/huggingface \
    DOCLING_CACHE_DIR=/home/scout/.cache/docling

# Pre-create the cache subtree as scout so first model fetch doesn't EACCES.
RUN mkdir -p /home/scout/.cache/huggingface /home/scout/.cache/docling \
 && chown -R scout:scout /home/scout/.cache

USER 1002

EXPOSE 8000

# Container-level healthcheck. Compose also declares one in compose.yaml;
# this baked-in copy means `docker run` works correctly without compose.
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
  CMD python -c "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/healthz').status == 200 else 1)" \
   || exit 1

# Single uvicorn worker. ADR-0001's single-user local-install model + the
# fully-async stack (asyncpg, openai, anyio threadpool for Docling) means a
# second worker buys little and complicates the in-process APScheduler:
# every worker process spawns its own scheduler against the shared Postgres
# jobstore and they race on table creation + job firing. A future "team
# install" deployment can re-evaluate (with a real leader-election layer).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
