# =====================================================================
# Scout — environment configuration.
# =====================================================================
# Copy to .env and fill in. Never commit .env (it's gitignored).
# Recommend `chmod 600 .env` on the host once your LLM key is in it.

# ---- General -----------------------------------------------------------
ENV=dev

# ---- Postgres ----------------------------------------------------------
# Superuser credentials. The container's POSTGRES_USER owns the database and
# is used by ALEMBIC for migrations. The api itself connects as the limited
# `app` role (see APP_DB_PASSWORD below).
POSTGRES_USER=scout
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scout

# Password for the limited `app` role created by 02-roles-and-schemas.sql.
# Default 'app' matches what's hardcoded in the init SQL. Rotate via
# `ALTER ROLE app PASSWORD '...';` in psql AND update this var in lockstep.
APP_DB_PASSWORD=app

# DATABASE_URL is composed automatically in compose.yaml and uses the app role:
#   postgresql+asyncpg://app:${APP_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Only override if running the api outside compose.

# ---- your LLM endpoint (OpenAI-compatible) ---------------------------------
# Provision a key from your LLM provider dashboard. Same key is used for chat and
# embeddings (both ride the OpenAI-compatible HTTP API).
LLM_BASE_URL=https://maas.example.redhat.com/v1
LLM_API_KEY=changeme

# Default chat model — used for extraction, rationale, narrative, agent chat
# unless overridden per purpose below.
LLM_CHAT_MODEL=llama-scout-17b

# Only embedding model on LLM API as of 2026-05; locked in plan 11.
LLM_EMBEDDING_MODEL=nomic-embed-text-v1-5

# Per-purpose overrides. Leave blank to use LLM_CHAT_MODEL.
# Switch LLM_EXTRACTION_MODEL to deepseek-r1-distill-qwen-14b if reasoning
# quality on scraped page extraction proves insufficient.
LLM_EXTRACTION_MODEL=
LLM_NARRATIVE_MODEL=
LLM_AGENT_MODEL=

# Deterministic canned responses for tests/demos. NEVER true in prod.
LLM_DRY_RUN=false

# Soft cap on monthly LLM spend (USD). Warn at 80%, refuse at 100%.
# Leave blank for unlimited (not recommended).
LLM_MONTHLY_BUDGET_USD=50

# ---- Optional safety classifier (step 29) -----------------------------
# When true, scraped page content + uploaded PDF text are run through
# Llama-Guard-3-1B before reaching the main chat model. ~+20% extraction cost.
SAFETY_CLASSIFIER_ENABLED=false
SAFETY_CLASSIFIER_MODEL=Llama-Guard-3-1B

# ---- Logging ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Scheduler --------------------------------------------------------
SCHEDULER_TIMEZONE=UTC

# ---- Scraper ----------------------------------------------------------
SCRAPER_USER_AGENT=Scout/1.0 (team Conference Discovery; +https://example.redhat.com/scout)
SCRAPER_DEFAULT_POLITENESS_SECONDS=3

# ---- Matcher tuning (env-only; no UI per plan 18) ---------------------
MATCH_M_GATE=0.55
MATCH_P_GATE=0.55
MATCH_S_GATE=0.5
MATCH_W_MESSAGING=0.35
MATCH_W_PILLAR=0.35
MATCH_W_SME=0.30
DECAY_ENABLED=true
